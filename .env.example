# At least one key is required. Gemini is primary, Groq is the fallback.
GOOGLE_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# Optional overrides
# DB_PATH=./data/healtrip.db
# VECTORS_PATH=./data/provider_vectors.json
# EMBEDDING_MODEL=Xenova/multilingual-e5-base
# REQUEST_TIMEOUT_MS=55000
# RATE_LIMIT_PER_MIN=20
# EMBEDDING_TIMEOUT_MS=8000
# HF_CACHE_DIR=./.cache/models
